\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scoring path. Shared attributes feed both trees. On the left, lookups and a SARIMAX build columns, and the tree returns a gap around the ask. On the right, lookups, written phrase flags, and a ridge build columns, the tree returns a log price, and one shift scales it. The OLS, the SARIMAX, the ridge, the tables, and \(\delta \) are all fit on sales that closed before the origin. The right path never reads list price, and a building comp has to have closed before the home was listed.}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:flow}{{3}{12}{Scoring path. Shared attributes feed both trees. On the left, lookups and a SARIMAX build columns, and the tree returns a gap around the ask. On the right, lookups, written phrase flags, and a ridge build columns, the tree returns a log price, and one shift scales it. The OLS, the SARIMAX, the ridge, the tables, and \(\delta \) are all fit on sales that closed before the origin. The right path never reads list price, and a building comp has to have closed before the home was listed}{figure.caption.5}{}}
